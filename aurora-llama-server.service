[Unit]
# llama-server als OpenAI-kompatibles Backend (z.B. Ternary Bonsai 27B) IM
# ROUTER-MODUS: ohne festes -m, Modelle kommen aus der Preset-Datei. Dadurch
# kann Aurora ein Modell per POST /models/unload gezielt entladen (wenn z.B.
# auf das lokale Ollama gewechselt wird — es bleibt nur EIN lokales Modell
# geladen, kein doppelter VRAM-Verbrauch).
#
# Ollama kann diese Modelle nicht laden: seinem ggml fehlt der q2_0-Typ.
#
# Einrichtung:
#   1. llama.cpp mit Vulkan bauen (AMD-iGPU) oder CUDA/ROCm nach Hardware:
#        cmake -B build -DGGML_VULKAN=ON -DCMAKE_BUILD_TYPE=Release -G Ninja
#        cmake --build build -j
#      Voraussetzungen auf Fedora: glslc, spirv-headers-devel, spirv-tools-devel
#   2. Modell nach ~/.local/share/aurora/models/ legen. Für Bonsai die
#      _g64-Datei nehmen — die group-128-Varianten laufen NUR im PrismML-Fork,
#      group-64 ist das Format, das llama.cpp upstream unterstützt.
#   3. Preset-Datei aurora-llama-models.ini nach
#      ~/.local/share/aurora/ kopieren und Pfade anpassen, dann:
#        cp aurora-llama-server.service ~/.config/systemd/user/
#        systemctl --user daemon-reload
#        systemctl --user enable --now aurora-llama-server
#   4. In Aurora unter Einstellungen den OpenAI-Endpunkt auf
#      http://127.0.0.1:8080 setzen.
Description=llama.cpp Router (OpenAI-kompatibles Backend für Aurora)
After=network.target

[Service]
# PASSE DIESEN PFAD AN:
Environment=LLAMA_BIN=%h/src/llama.cpp/build/bin/llama-server
# Pfad zur Preset-Datei (Modelle + Argumente), siehe aurora-llama-models.ini
Environment=LLAMA_PRESET=%h/.local/share/aurora/aurora-llama-models.ini
# WICHTIG: KEIN -m. Der Router lädt Modelle on demand aus der Preset (mit
# load-on-startup=true ist Bonsai beim Start bereits geladen — bisheriges
# Verhalten). Der Port bleibt 8080, NICHT 8000/8001 (Speaches/aichat).
ExecStart=/bin/sh -c 'exec "$LLAMA_BIN" --models-preset "$LLAMA_PRESET" \
    --host 127.0.0.1 --port 8080'
Restart=on-failure
RestartSec=5
# Das vorab geladene Modell wird beim Start vollständig eingelesen.
TimeoutStartSec=600

[Install]
WantedBy=default.target